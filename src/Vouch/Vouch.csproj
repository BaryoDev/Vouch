<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Existing reflection in Formatter, MemberCache and Equivalency; still reported as warnings, not errors. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2070;IL2075</WarningsNotAsErrors>
    <PackageId>Vouch</PackageId>
    <Description>Fluent assertions for .NET with no dependencies. The .Should() surface of FluentAssertions, with failure messages built only when an assertion fails.</Description>
    <PackageTags>assertions testing fluentassertions should</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vouch.Tests" />
  </ItemGroup>

</Project>
